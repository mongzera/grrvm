::_global ; main entry subroutine (local memory only)
    PUSH 0
    STORE_L 0          ; n : uint32 -> L0
    .while_cond_0: ; while loop condition
    LOAD_L 0           ; load n
    PUSH 1000000
    CMPLT
    JZ .while_end_1    ; exit while loop if 0
    LOAD_L 0           ; load n
    DUP
    INC 1              ; n++
    STORE_L 0          ; update n
    POP                ; discard unused expression result
    JUMP .while_cond_0 ; repeat while loop
    .while_end_1: ; end while
    HALT               ; terminate program
