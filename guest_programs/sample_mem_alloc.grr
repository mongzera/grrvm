::_global
    PUSH 0 ;
    STORE_L 0

    .while_0:
        PUSH 1 ; Minimum number of slots
        PUSH 2023 ; Maximum number of slots
        INVOKE_NATIVE math_rng_range
        H_ALLOC
        POP
        LOAD_L 0
        INC 1
        STORE_L 0
        LOAD_L 0
        PUSH 10000
        CMPGT
        JZ .while_0
    HALT
