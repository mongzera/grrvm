; Allocation speed workload.
;
; Measures the SOP variable: allocation latency, as elapsed_us / allocs per
; timed batch. 30 batches matches the SOP's n = 30.
;
; Each batch allocates 64 random-sized blocks on the no-GC fast path, then
; releases them AFTER the timer stops, so the measured window contains only
; allocation work. Peak live heap is bounded by
;   per_batch * max_slots = 64 * 256 = 16,384 slots (131 KB)
; which fits the Pico's 25,600-slot (200 KB) heap with room to spare.
;
; 30 * 64 = 1,920 timed allocations per run (~2,000 as the SOP specifies).
;
; bench_alloc(batches, per_batch, min_slots, max_slots, seed)

::_global
    INVOKE_NATIVE telemetry_reset

    PUSH 30
    PUSH 64
    PUSH 32
    PUSH 256
    PUSH_T uint32 20261
    INVOKE_NATIVE bench_alloc

    INVOKE_NATIVE telemetry_flush
    HALT
