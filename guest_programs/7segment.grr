::_global
    CALL setup
    HALT

::gpio_delay
    STORE_L 0
    INVOKE_NATIVE timer_us
    STORE_L 1
    .while_cond_0:
    INVOKE_NATIVE timer_us
    LOAD_L 1
    SUB
    LOAD_L 0
    PUSH 1000
    MUL
    CMPLTE
    JZ .while_end_1
    JUMP .while_cond_0
    .while_end_1:
    RET

::setup
    PUSH 1
    STORE_L 0
    .while_cond_0:
    LOAD_L 0
    PUSH 7
    CMPLTE
    JZ .while_end_1
    LOAD_L 0
    PUSH_T uint8 1
    PUSH_T uint8 0
    INVOKE_NATIVE gpio_init
    LOAD_L 0
    PUSH 1
    ADD
    STORE_L 0
    JUMP .while_cond_0
    .while_end_1:
    PUSH 1000
    CALL gpio_delay
    .while_cond_2:
    PUSH 1
    JZ .while_end_3
    CALL loop
    JUMP .while_cond_2
    .while_end_3:
    RET

