::loop
    PUSH 9
    STORE_L 0
    .while_cond_0:
    LOAD_L 0
    PUSH 0
    CMPGTE
    JZ .while_end_1
    LOAD_L 0
    CALL displayDigit
    PUSH 1000
    CALL gpio_delay
    LOAD_L 0
    PUSH 0
    CMPEQ
    JZ .endif_2
    JUMP .while_end_1
    .endif_2:
    LOAD_L 0
    PUSH 1
    SUB
    STORE_L 0
    JUMP .while_cond_0
    .while_end_1:
    RET
