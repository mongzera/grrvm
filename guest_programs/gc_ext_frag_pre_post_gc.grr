::_global
    PUSH 1
    INVOKE_NATIVE set_ext_frag_telemetry_flag
    PUSH 0 ;
    STORE_L 0

    .while_0:
        PUSH 1 ; Minimum number of slots
        PUSH 2023 ; Maximum number of slots
        INVOKE_NATIVE math_rng_range
        H_ALLOC
        POP
        LOAD_L 0
        INC 1
        STORE_L 0
        LOAD_L 0
        PUSH 2000
        CMPGT
        JZ .while_0

    INVOKE_NATIVE dump_ext_frag_telemetry
    HALT
