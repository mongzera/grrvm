; GC pause ("jitter") workload.
;
; Measures the SOP variable: the distribution of stop-the-world pause times,
; sampled once per collection by run_gc().
;
; This workload MUST run in guest code. The collector's only roots are the
; thread stacks (call_stack_frame / op_stack) and the global heap block, so a
; block whose reference is held anywhere else - a C static in a native, for
; instance - is swept at the next collection. Retained "islands" therefore
; have to live in locals 1..3, which are part of the call frame and are
; scanned by mark_object().
;
; Shape of one round:
;   - allocate 3 anchors of random size and store them in locals 1..3. The
;     previous anchor in each local becomes unreachable garbage, which is
;     what fragments the heap around the surviving islands.
;   - allocate 1 large transient and discard it immediately.
; One round = 4 allocations, so 500 rounds = the SOP's 2,000 allocations.
;
; rand_seed makes the size sequence identical on every run and every runtime;
; without it the POSIX port seeds from /dev/urandom and the run is not
; reproducible.
;
; Nothing is printed until the single telemetry_flush at the end, so console
; latency cannot enter a pause sample. n = 30 independent runs is the
; evaluator's job: run this image 30 times.

::_global
    INVOKE_NATIVE telemetry_reset

    PUSH 1
    INVOKE_NATIVE set_ext_frag_telemetry_flag

    PUSH 1
    INVOKE_NATIVE set_gc_runtime_telemetry_flag

    PUSH_T uint32 12345
    INVOKE_NATIVE rand_seed

    ; Locals: 0 = round counter, 1..3 = live anchors (GC roots)
    PUSH 0
    STORE_L 0
    PUSH 0
    STORE_L 1
    PUSH 0
    STORE_L 2
    PUSH 0
    STORE_L 3

.round:
    LOAD_L 0
    PUSH 500
    CMPLT
    JZ .done

    ; Anchor 1: 24..1024 slots
    PUSH 24
    PUSH 1024
    INVOKE_NATIVE math_rng_range
    H_ALLOC
    STORE_L 1

    ; Anchor 2: 1..2048 slots
    PUSH 1
    PUSH 2048
    INVOKE_NATIVE math_rng_range
    H_ALLOC
    STORE_L 2

    ; Anchor 3: 128..512 slots
    PUSH 128
    PUSH 512
    INVOKE_NATIVE math_rng_range
    H_ALLOC
    STORE_L 3

    ; Transient: 1203..4014 slots, discarded immediately
    PUSH 1203
    PUSH 4014
    INVOKE_NATIVE math_rng_range
    H_ALLOC
    POP

    LOAD_L 0
    INC 1
    STORE_L 0
    JUMP .round

.done:
    INVOKE_NATIVE telemetry_flush
    HALT
